# Local configuration for chora-wbl.
# Copy to .env and fill in values. Never commit .env or secrets.

PORT=8080
CHORA_ENV=local

# Logical source-project label stamped on emitted event envelopes.
# Defaults to chora-local when unset.
CHORA_SOURCE_PROJECT=chora-local

# Tracing — OTLP/gRPC endpoint (the OTel Collector). Unset falls back to stdout.
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
# Force the stdout exporter in local dev (overrides the endpoint).
# OTEL_EXPORTER=stdout
DEPLOYMENT_ENVIRONMENT=local
